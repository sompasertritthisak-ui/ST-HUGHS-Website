{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shv-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Settings that are the same on every account live here. Per-deployment values
  // (APPLICATION_URL, MEDIA_PUBLIC_URL) and secrets (DATABASE_URL, AUTH_SECRET) are set in the
  // Cloudflare dashboard: Worker → Settings → Variables and Secrets. `keep_vars` stops a deploy
  // from wiping dashboard variables, so the same repository serves the draft Worker on a personal
  // account and the production Worker on the college account.
  "keep_vars": true,
  "vars": {
    "NEXTJS_ENV": "production",
    "AUTH_TRUST_HOST": "true",
    "NEXT_PUBLIC_CF_IMAGE_TRANSFORMS": "0"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "shv-website" }],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "shv-next-cache" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "shv-media" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }]
}
