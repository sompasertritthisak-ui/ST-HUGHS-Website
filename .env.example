# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite. Production: PostgreSQL, e.g. postgresql://user:pass@host:5432/shv
DATABASE_URL="file:./dev.db"

# ── Auth (Auth.js v5) ─────────────────────────────────────────────────────────
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_TRUST_HOST=true
# Optional SSO for staff (Google Workspace / Microsoft 365)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APPLICATION_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@sthughs.edu.la"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
# First deploy only: seed the production database during the build, then REMOVE this variable.
SEED_ON_BUILD=
# Set to 1 if you manage the schema with prisma migrate instead of db push at build time.
SKIP_DB_PUSH=

# ── Storage (media uploads) ──────────────────────────────────────────────────
# Local disk (public/uploads) is used in development. On Cloudflare Workers uploads go to
# the R2 bucket bound as MEDIA_BUCKET in wrangler.jsonc and are served from this public URL
# (the bucket's custom domain, e.g. https://media.sthughs.edu.la).
MEDIA_PUBLIC_URL=
# Set to 1 once Cloudflare Images → Transformations is enabled on the zone, to resize/convert
# images on the edge via /cdn-cgi/image. Leave 0 to serve original files.
NEXT_PUBLIC_CF_IMAGE_TRANSFORMS=0

# ── Email / notifications ─────────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM="admissions@sthughs.edu.la"
ADMISSIONS_NOTIFY_EMAIL=

# ── Integrations (future) ─────────────────────────────────────────────────────
ANALYTICS_ID=
CRM_WEBHOOK_URL=
CRM_API_KEY=
WHATSAPP_NUMBER=
MAP_API_KEY=
