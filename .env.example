# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite. Production: PostgreSQL, e.g. postgresql://user:pass@host:5432/shv
DATABASE_URL="file:./dev.db"

# ── Auth (Auth.js v5) ─────────────────────────────────────────────────────────
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_TRUST_HOST=true
# Optional SSO for staff (Google Workspace / Microsoft 365)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APPLICATION_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@sthughs.edu.la"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
# First deploy only: seed the production database during the build, then REMOVE this variable.
SEED_ON_BUILD=
# Set to 1 if you manage the schema with prisma migrate instead of db push at build time.
SKIP_DB_PUSH=

# ── Storage (media uploads). Local disk is used when unset. ──────────────────
# Vercel: create a Blob store in the Vercel dashboard (Storage → Blob) and it sets this for you.
BLOB_READ_WRITE_TOKEN=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ── Email / notifications ─────────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM="admissions@sthughs.edu.la"
ADMISSIONS_NOTIFY_EMAIL=

# ── Integrations (future) ─────────────────────────────────────────────────────
ANALYTICS_ID=
CRM_WEBHOOK_URL=
CRM_API_KEY=
WHATSAPP_NUMBER=
MAP_API_KEY=
